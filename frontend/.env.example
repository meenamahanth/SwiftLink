# ─────────────────────────────────────────────────────────────────────────────
# SwiftLink Frontend — Environment Variable Template
# Rename this file to .env.local for local development
# In Vercel, set VITE_API_BASE_URL in the Project > Settings > Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# The base URL of the Spring Boot backend API
# Local development:
VITE_API_BASE_URL=http://localhost:8080

# Production (Render deployment):
# VITE_API_BASE_URL=https://your-backend-name.onrender.com
