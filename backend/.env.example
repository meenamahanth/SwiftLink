# ─────────────────────────────────────────────────────────────────────────────
# SwiftLink Backend — Environment Variable Template
# Copy this file to .env for local development
# Set these variables directly in Render Dashboard for production
# NEVER commit .env to Git
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=8080

# PostgreSQL connection string
# Neon format: jdbc:postgresql://YOUR_HOST/YOUR_DATABASE?sslmode=require
# Local Docker format: jdbc:postgresql://postgres:5432/urlshortener
DATABASE_URL=jdbc:postgresql://YOUR_HOST/YOUR_DATABASE?sslmode=require

# Database credentials
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# JWT secret key (Base64 encoded, minimum 256-bit / 32 characters)
# Generate securely with: openssl rand -base64 64
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET_WITH_OPENSSL

# Token expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Frontend URL for CORS origin allowlist
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Public base URL for building short redirect links
# Local: http://localhost:8080
# Production: https://your-backend.onrender.com
APP_URL=http://localhost:8080
